# Agora ortam değişkenleri örneği
# Bu dosyayı `.env` olarak kopyalayıp anahtarları doldurun: copy .env.example .env
# .env dosyası sürüm kontrolüne girmez; anahtarları asla koda yazmayın.

# Zorunlu: kategori etiketleme ve çerçeve karşılaştırması için DeepSeek anahtarı
DEEPSEEK_API_KEY=

# İsteğe bağlı: kullanılmıyorsa boş bırakılabilir
OPENAI_API_KEY=
